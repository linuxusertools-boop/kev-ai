# Wajib. Service account Firebase (Project settings > Service accounts > Generate new private key).
# Isi dengan JSON utuh ATAU hasil base64 dari JSON itu.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_DATABASE_URL=https://kev-ai-a422b-default-rtdb.asia-southeast1.firebasedatabase.app

# Disarankan. Tanpa ini server memakai jalur cadangan (scraper gemini.google.com) yang rapuh.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opsional. Asal tambahan yang boleh memanggil /api/session (pisahkan koma).
ALLOWED_ORIGINS=
# Opsional. Garam untuk hash IP di rate limit.
IP_SALT=
